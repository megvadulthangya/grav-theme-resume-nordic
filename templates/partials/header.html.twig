{# Load Theme Config #}
{# JAVÍTÁS: Ha nincs beállítás, akkor alapból legyen BEKAPCSOLVA (true) #}
{% set avatar_enabled = theme_config.gravatar_enabled|default(true) %}
{% set avatar_size = theme_config.gravatar_size|default(200) %}

{# --- AVATAR LOGIC PRIORITY --- #}
{# 1. Custom Uploaded File #}
{% set local_image = theme_config.custom_avatar_image|first %}
{# 2. Gravatar Email (CSAK akkor, ha a Témában külön beírták!) #}
{% set grav_email = theme_config.gravatar_email %}
{# 3. Default Fallback Image (Lars) #}
{% set default_image = 'default-avatar.jpg' %}

<div id="header">
    <div class="row">
        {# Column 1: Profile Picture #}
        <div class="large-3 columns text-center">
           
            {% if avatar_enabled %}
                <div style="margin-bottom: 0.5rem;">
                    
                    {# A) LOCAL CUSTOM IMAGE #}
                    {% if local_image %}
                        <img src="{{ url('theme://assets/' ~ local_image.name) }}" 
                             alt="{{ site.title }}" 
                             style="border-radius: 50%; width: {{ avatar_size }}px; height: {{ avatar_size }}px; border: 6px solid #4C566A; display: inline-block; object-fit: cover;" />
                    
                    {# B) GRAVATAR (If no local image, but email exists) #}
                    {% elseif grav_email %}
                        <img src="https://www.gravatar.com/avatar/{{ grav_email|trim|md5 }}?s={{ avatar_size * 2 }}" 
                             alt="{{ site.title }}" 
                             style="border-radius: 50%; width: {{ avatar_size }}px; height: {{ avatar_size }}px; border: 6px solid #4C566A; display: inline-block;" />

                    {# C) DEFAULT FALLBACK (LARS) - If nothing is configured #}
                    {% else %}
                         <img src="{{ url('theme://assets/' ~ default_image) }}" 
                             alt="{{ site.title }}" 
                             style="border-radius: 50%; width: {{ avatar_size }}px; height: {{ avatar_size }}px; border: 6px solid #4C566A; display: inline-block; object-fit: cover;" />
                    {% endif %}

                </div>
            {% endif %}

            {% if site.title %}
                <h2 style="font-weight: bold; margin-top: 0.5rem;">{{ site.title }}</h2>
            {% endif %}   
            {% if site.description %}
                <h6 class="light">{{ site.description }}</h6>
            {% endif %}
        </div>

        {# Column 2: Address #}
        <div class="large-3 columns">
            <div class="row">
                <div class="small-4 columns light2 italic">Address:</div>
                <div class="small-8 columns border-left light2 ">
                    <ul class="no-bullet">
                        {% for item in site.address %}<li>{{ item.line }}</li>{% endfor %}
                    </ul>
                </div>
            </div>
        </div>

        {# Column 3: Contact #}
        <div class="large-3 columns">
            <div class="row">
                <div class="small-4 columns light2 italic">Contact:</div>
                <div class="small-8 columns border-left light2">
                    <ul class="no-bullet">
                        {% for item in site.contact %}
                            <li>
                                {# Ha a YAML-ben meg van adva URL, azt használjuk (ez volt az eredeti logika) #}
                                {% if item.url %}
                                    <a href="{{ item.url }}" {% if item.target %}target="{{ item.target }}"{% endif %} style="color: inherit; text-decoration: none; transition: color 0.3s;" onmouseover="this.style.color='#88C0D0'" onmouseout="this.style.color='inherit'">
                                        {% if item.icon %}<i class="fa fa-{{ item.icon }}"></i> {% endif %}
                                        {{ item.text }}
                                    </a>
                                
                                {# HA NINCS URL, AKKOR DETEKTÁLUNK (EZ AZ ÚJ RÉSZ!) #}
                                {% else %}
                                
                                    {# 1. EMAIL DETEKTÁLÁS (Ha van benne @ és pont) #}
                                    {% if '@' in item.line and '.' in item.line %}
                                        <a href="mailto:{{ item.line }}" style="color: inherit; text-decoration: none; transition: color 0.3s;" onmouseover="this.style.color='#88C0D0'" onmouseout="this.style.color='inherit'">
                                            <i class="fa-solid fa-envelope" style="margin-right: 5px; width: 15px;"></i>{{ item.line }}
                                        </a>

                                    {# 2. TELEFON DETEKTÁLÁS (Ha + jellel vagy számmal kezdődik) #}
                                    {% elseif item.line|trim|first == '+' or item.line|trim matches '/^[0-9]/' %}
                                        {# A replace kiszedi a szóközöket a href-ből, hogy a telefon tárcsázni tudja #}
                                        <a href="tel:{{ item.line|replace({' ': '', '-': '', '(': '', ')': ''}) }}" style="color: inherit; text-decoration: none; transition: color 0.3s;" onmouseover="this.style.color='#88C0D0'" onmouseout="this.style.color='inherit'">
                                            <i class="fa-solid fa-phone" style="margin-right: 5px; width: 15px;"></i>{{ item.line }}
                                        </a>

                                    {# 3. TWITTER / SOCIAL (Ha @-al kezdődik, de nem email) #}
                                    {% elseif item.line|trim|first == '@' %}
                                        <a href="https://twitter.com/{{ item.line|replace({'@': ''}) }}" target="_blank" style="color: inherit; text-decoration: none; transition: color 0.3s;" onmouseover="this.style.color='#88C0D0'" onmouseout="this.style.color='inherit'">
                                            <i class="fa-brands fa-twitter" style="margin-right: 5px; width: 15px;"></i>{{ item.line }}
                                        </a>

                                    {# 4. EGYÉB SZÖVEG (Ha semmi fenti nem igaz) #}
                                    {% else %}
                                        {{ item.line }}
                                    {% endif %}
                                    
                                {% endif %}
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            </div>
        </div>

        {# Column 4: Website #}
        <div class="large-2 columns text-right italic website">
            <a href="http://{{ site.website }}" target="_blank">{{ site.website }}</a>
        </div>
    </div>
</div>
